# =================================================================
# BACKEND ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to backend/.env and fill in your actual values
# Do NOT add frontend variables (NEXT_PUBLIC_*) here
# =================================================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_assistant

# 9Router Configuration (Local or Cloud)
# For local 9Router: http://localhost:20128
# For cloud 9Router: https://api.9router.ai
NINEROUTER_BASE_URL=http://localhost:20128
NINEROUTER_API_KEY=your_9router_api_key_here
DEFAULT_MODEL=ai-general
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# File Upload
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf","docx","txt","md","csv"]
UPLOAD_DIR=uploads

# Security (JSON array format - Pydantic Settings will parse this)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
